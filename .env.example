# Database
DB_NAME=casas_campo
DB_USER=casas_user
DB_PASSWORD=change_in_production

# JWT Auth
JWT_SECRET=change_in_production_use_openssl_rand_hex_32
NEXTAUTH_SECRET=change_in_production_use_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3100

# MinIO File Storage
MINIO_USER=admin
MINIO_PASSWORD=change_in_production_min_8_chars
MINIO_SECURE=false
NEXT_PUBLIC_MINIO_URL=http://localhost:9100

# API URLs / CORS
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100

# Auth expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP (email verification + password reset)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=admin@example.com
SMTP_PASSWORD=change_in_production
SMTP_ENCRYPTION=ssl
SMTP_FROM_EMAIL=admin@example.com

# WhatsApp Business Cloud API (Meta) — canal principal de notificaciones y OTP
# Requiere: WABA verificada, numero registrado y token PERMANENTE de System User
# (Business Settings -> System Users -> Generate token, permiso whatsapp_business_messaging).
# NO usar el token temporal de 24h del panel de desarrollador.
# WHATSAPP_DRY_RUN=true loguea los payloads sin llamar a la API (para desarrollo).
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=EAAG_change_in_production
WHATSAPP_DEFAULT_COUNTRY_CODE=591
WHATSAPP_TEMPLATE_LANG=es
# Nombres de las plantillas aprobadas en Meta Business Manager
WHATSAPP_TEMPLATE_OTP=codigo_verificacion
WHATSAPP_TEMPLATE_ADMIN_NEW_RESERVATION=admin_nueva_reserva
WHATSAPP_TEMPLATE_ADMIN_VOUCHER_UPLOADED=admin_comprobante_subido
WHATSAPP_TEMPLATE_RESERVATION_APPROVED=reserva_aprobada
WHATSAPP_TEMPLATE_RESERVATION_REJECTED=reserva_rechazada
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=pago_recibido
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=pago_confirmado
# Click-to-chat: numero del negocio en E.164 SIN '+' (enlace wa.me).
# Permite entregar el codigo por WhatsApp abriendo la ventana de servicio de 24h
# (sin plantilla AUTHENTICATION). Requiere webhook publico configurado en Meta.
WHATSAPP_BUSINESS_NUMBER=
# Token que TU eliges; debe coincidir con el configurado en Meta > Webhooks
WHATSAPP_VERIFY_TOKEN=cambia_este_token
# App secret de la app de Meta (valida la firma X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# OTP (verificacion de cuenta y reset de contrasena por codigo)
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Cookie / security hardening
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
