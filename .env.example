# Database
DB_NAME=casas_campo
DB_USER=casas_user
DB_PASSWORD=change_in_production

# JWT Auth
JWT_SECRET=change_in_production_use_openssl_rand_hex_32
NEXTAUTH_SECRET=change_in_production_use_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3100

# MinIO File Storage
MINIO_USER=admin
MINIO_PASSWORD=change_in_production_min_8_chars
MINIO_SECURE=false
NEXT_PUBLIC_MINIO_URL=http://localhost:9100

# API URLs / CORS
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100

# Auth expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP (email verification + password reset)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=admin@example.com
SMTP_PASSWORD=change_in_production
SMTP_ENCRYPTION=ssl
SMTP_FROM_EMAIL=admin@example.com

# Cookie / security hardening
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
